rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from an authenticated admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public read for products, category catalog, and active payment accounts
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Orders: Anyone can create order; Admins can read/update all order statuses
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (request.auth != null && resource.data.customerPhone == request.auth.token.phone_number);
    }
    
  }
}
